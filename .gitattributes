* text=auto

# 类 Unix 启动脚本必须是 LF，否则 macOS/Linux 无法执行
启动-macOS.command text eol=lf
启动-Linux.sh text eol=lf
*.sh text eol=lf
*.command text eol=lf

# Windows 批处理必须是 CRLF
启动-Windows.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 资源与二进制
*.png binary
*.jpg binary
*.wav binary
*.mp4 binary
*.pdf binary
*.zip binary
